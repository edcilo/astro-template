---
interface Props {
	showLogo: boolean;
	showVersion: boolean;
	version: string;
	description?: string;
}

import Logo from './Logo.astro';

const { showLogo, showVersion, version, description } = Astro.props;
---

<div class="flex flex-col gap-3">
	{
		showLogo && (
			<a href="/" aria-label="Home">
				<Logo class="h-8 w-auto text-gray-900 dark:text-gray-100" />
			</a>
		)
	}
	{showVersion && <span class="text-xs text-gray-500 dark:text-gray-400">v{version}</span>}
	{
		description && (
			<p class="text-sm leading-relaxed text-gray-600 dark:text-gray-400">{description}</p>
		)
	}
</div>
