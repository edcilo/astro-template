---
import type { SocialLink } from '../config/site';

interface Props {
	email?: string;
	socialLinks: SocialLink[];
}

const { email, socialLinks } = Astro.props;

const socialIcons: Record<string, string> = {
	facebook: '<path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>',
	x: '<path d="M4 4l6.5 8L4 20h2l5.5-6.8L16 20h4l-6.8-8.5L20 4h-2l-5.2 6.4L9 4H4z"/>',
	instagram:
		'<rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>',
	linkedin:
		'<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/>',
	github:
		'<path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>',
};
---

<div class="flex flex-col gap-3">
	<h3 class="text-sm font-semibold tracking-wider text-gray-900 uppercase dark:text-gray-100">
		Contact
	</h3>
	{
		email && (
			<a
				href={`mailto:${email}`}
				class="text-sm text-gray-600 transition-colors hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-100"
			>
				{email}
			</a>
		)
	}
	{
		socialLinks.length > 0 && (
			<div class="flex gap-3">
				{socialLinks.map((link) => (
					// eslint-disable-next-line @typescript-eslint/no-unsafe-return
					<a
						href={link.url}
						target="_blank"
						rel="noopener noreferrer"
						aria-label={link.platform}
						class="text-gray-500 transition-colors hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-100"
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							class="h-5 w-5"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
							set:html={socialIcons[link.platform]}
						/>
					</a>
				))}
			</div>
		)
	}
</div>
