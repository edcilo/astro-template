---
// eslint-disable-next-line @typescript-eslint/no-empty-object-type
interface Props {}

const _props = Astro.props;
void _props;
---

<button
	type="button"
	data-theme-toggle
	aria-label="Theme: system"
	class="inline-flex items-center justify-center rounded-md p-2 text-gray-600 transition-colors hover:bg-gray-100 hover:text-gray-900 dark:text-gray-300 dark:hover:bg-gray-700 dark:hover:text-gray-100"
>
	<!-- Sun icon (light) -->
	<svg
		data-theme-icon="light"
		xmlns="http://www.w3.org/2000/svg"
		class="hidden h-5 w-5"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
	>
		<circle cx="12" cy="12" r="5"></circle>
		<line x1="12" y1="1" x2="12" y2="3"></line>
		<line x1="12" y1="21" x2="12" y2="23"></line>
		<line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
		<line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
		<line x1="1" y1="12" x2="3" y2="12"></line>
		<line x1="21" y1="12" x2="23" y2="12"></line>
		<line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
		<line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
	</svg>
	<!-- Moon icon (dark) -->
	<svg
		data-theme-icon="dark"
		xmlns="http://www.w3.org/2000/svg"
		class="hidden h-5 w-5"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
	>
		<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
	</svg>
	<!-- Monitor icon (system) -->
	<svg
		data-theme-icon="system"
		xmlns="http://www.w3.org/2000/svg"
		class="h-5 w-5"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
	>
		<rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
		<line x1="8" y1="21" x2="16" y2="21"></line>
		<line x1="12" y1="17" x2="12" y2="21"></line>
	</svg>
</button>

<script>
	type Theme = 'light' | 'dark' | 'system';

	const THEME_KEY = 'theme';
	const CYCLE: Theme[] = ['light', 'dark', 'system'];

	function getStoredTheme(): Theme {
		const stored = localStorage.getItem(THEME_KEY);
		if (stored === 'light' || stored === 'dark' || stored === 'system') {
			return stored;
		}
		return 'system';
	}

	function getEffectiveTheme(theme: Theme): 'light' | 'dark' {
		if (theme === 'system') {
			return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
		}
		return theme;
	}

	function applyTheme(theme: Theme): void {
		const effective = getEffectiveTheme(theme);
		document.documentElement.classList.toggle('dark', effective === 'dark');
	}

	function updateAllIcons(theme: Theme): void {
		const buttons = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');
		const lightIcons = document.querySelectorAll<SVGElement>('[data-theme-icon="light"]');
		const darkIcons = document.querySelectorAll<SVGElement>('[data-theme-icon="dark"]');
		const systemIcons = document.querySelectorAll<SVGElement>('[data-theme-icon="system"]');

		lightIcons.forEach((icon) => icon.classList.toggle('hidden', theme !== 'light'));
		darkIcons.forEach((icon) => icon.classList.toggle('hidden', theme !== 'dark'));
		systemIcons.forEach((icon) => icon.classList.toggle('hidden', theme !== 'system'));

		buttons.forEach((btn) => btn.setAttribute('aria-label', `Theme: ${theme}`));
	}

	function handleToggleClick(): void {
		const stored = getStoredTheme();
		const currentIndex = CYCLE.indexOf(stored);
		const nextTheme = CYCLE[(currentIndex + 1) % CYCLE.length];
		if (!nextTheme) return;

		localStorage.setItem(THEME_KEY, nextTheme);
		applyTheme(nextTheme);
		updateAllIcons(nextTheme);
	}

	function initThemeToggle(): void {
		const buttons = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');
		if (buttons.length === 0) return;

		const currentTheme = getStoredTheme();
		applyTheme(currentTheme);
		updateAllIcons(currentTheme);

		buttons.forEach((btn) => {
			btn.removeEventListener('click', handleToggleClick);
			btn.addEventListener('click', handleToggleClick);
		});
	}

	// Listen for system theme changes when in "system" mode
	window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
		if (getStoredTheme() === 'system') {
			applyTheme('system');
			updateAllIcons('system');
		}
	});

	initThemeToggle();
	document.addEventListener('astro:after-swap', initThemeToggle);
</script>
